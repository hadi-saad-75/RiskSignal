# RiskSignal API image: the FastAPI backend, the engines and the synthetic Atlas Bank database.
# Build context is the repository root.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install the dependencies first so this slow layer is cached until pyproject.toml changes.
# A stub package lets pip install the project (editable, so the data path resolves to /app/data).
COPY pyproject.toml README.md ./
RUN mkdir -p src/risksignal && touch src/risksignal/__init__.py && pip install -e .

COPY src ./src

# Explicit setup step: generate the synthetic Atlas Bank (CSV files and SQLite database).
# The generator is seeded, so every build produces the same data.
RUN python -m risksignal.data.generator

RUN useradd --create-home --uid 1000 app && chown -R app:app /app
USER app

EXPOSE 8000
# The API listens on all interfaces inside the container; docker-compose publishes it on localhost only.
# Hosting platforms that set $PORT are honoured; the default is 8000.
CMD ["sh", "-c", "exec uvicorn risksignal.api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
